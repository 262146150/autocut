{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ECutAuto-Clone 默认权限（对应逆向出的 ACL 集）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**", "$DESKTOP/**", "$VIDEO/**", "$APPLOCALDATA/**"]
    }
  ]
}
